{
  "uid": "taskboard",
  "title": "Taskboard",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests per second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(taskboard_http_requests_total[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "95th percentile API latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(taskboard_http_request_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Application logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "{namespace=\"taskboard\"}", "queryType": "range"}]
    }
  ]
}
